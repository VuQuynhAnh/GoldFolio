PORT=4000
# PostgreSQL. Supabase: nút "Connect" của project → Connection string → chọn "Session pooler"
# (chạy được cả mạng chỉ có IPv4), dán nguyên chuỗi vào đây và thay mật khẩu database.
# Không có DATABASE_URL thì pg đọc PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
DATABASE_URL=
# Tuỳ chọn: đường dẫn file CA của Supabase (Project Settings → Database → SSL Configuration →
# Download certificate) để mã hoá và kiểm chứng chỉ. Bỏ trống = kết nối không SSL.
DB_SSL_CA=
# Chu kỳ lấy giá hiện tại từ nguồn (phút)
PRICE_INTERVAL_MIN=15
# Đặt 0 để tắt lấy giá tự động (vd khi dev offline)
PRICE_FETCH_ENABLED=1
# Tuỳ chọn: AI nhận định xu hướng giá (tab Biểu đồ). API key miễn phí tạo ở
# aistudio.google.com → Get API key. Bỏ trống = tắt AI, app vẫn chạy bình thường.
GEMINI_API_KEY=
# Tuỳ chọn: model Gemini, mặc định gemini-3.6-flash.
GEMINI_MODEL=
# Tuỳ chọn: model dự phòng khi model chính quá tải (503) hoặc hết lượt (429), mặc định gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=
